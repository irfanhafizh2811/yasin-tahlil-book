<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/bg_counter_screen_flowers">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="?android:actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/actionBarItemBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_back"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/llDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="?attr/actionBarItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/llThemes"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivDelete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_delete"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llThemes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="?attr/actionBarItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/llMore"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivThemes"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_theme"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="?attr/actionBarItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivMore"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ic_more_new"
                tools:ignore="ContentDescription" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/llDzikir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/vwCounter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivDzikir"
            android:layout_width="120dp"
            android:layout_height="64dp"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/ic_astagfirllah" />

        <TextView
            android:id="@+id/tvDzikir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:letterSpacing="0.01"
            android:textSize="20sp"
            android:textStyle="normal"
            tools:targetApi="lollipop"
            tools:text="Subhanallah"
            tools:textColor="@android:color/black" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTargetCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@id/vwCounter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llDzikir">

        <ImageView
            android:id="@+id/ivTargetCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/bg_target_counter_flowers" />

        <TextView
            android:id="@+id/tvTargetCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.01"
            android:textSize="15sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="@id/ivTargetCounter"
            app:layout_constraintEnd_toEndOf="@id/ivTargetCounter"
            app:layout_constraintStart_toStartOf="@id/ivTargetCounter"
            app:layout_constraintTop_toTopOf="@id/ivTargetCounter"
            tools:targetApi="lollipop"
            tools:text="33"
            tools:textColor="@android:color/black" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vwCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llDzikir">

        <ImageView
            android:id="@+id/ivSkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/bg_tasbeeh_digital_flowers" />

        <ImageView
            android:id="@+id/ivCounterSkinBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/bg_output_flowers" />

        <TextView
            android:id="@+id/tvHintCounter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fontFamily="@font/font_digital_seven"
            android:gravity="center_vertical|end"
            android:lines="1"
            android:maxLength="5"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/label_text_counter_hint"
            android:textAlignment="gravity"
            android:textSize="70sp"
            app:layout_constraintBottom_toBottomOf="@id/ivCounterSkinBox"
            app:layout_constraintEnd_toEndOf="@id/ivCounterSkinBox"
            app:layout_constraintStart_toStartOf="@id/ivCounterSkinBox"
            app:layout_constraintTop_toTopOf="@id/ivCounterSkinBox"
            tools:text="00000"
            tools:textColor="@color/textHintOutputFlowers"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCounter1"
            android:layout_width="40sp"
            android:layout_height="0dp"
            android:fontFamily="@font/font_digital_seven"
            android:gravity="center_vertical|end"
            android:lines="1"
            android:maxLength="1"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:textAlignment="gravity"
            android:textColor="@android:color/black"
            android:textSize="70sp"
            app:layout_constraintBottom_toBottomOf="@id/ivCounterSkinBox"
            app:layout_constraintEnd_toEndOf="@id/ivCounterSkinBox"
            app:layout_constraintTop_toTopOf="@id/ivCounterSkinBox"
            tools:text="9" />

        <TextView
            android:id="@+id/tvCounter2"
            android:layout_width="32sp"
            android:layout_height="0dp"
            android:fontFamily="@font/font_digital_seven"
            android:gravity="center_vertical|end"
            android:lines="1"
            android:maxLength="1"
            android:paddingBottom="8dp"
            android:textAlignment="gravity"
            android:textColor="@android:color/black"
            android:textSize="70sp"
            app:layout_constraintBottom_toBottomOf="@id/ivCounterSkinBox"
            app:layout_constraintEnd_toStartOf="@id/tvCounter1"
            app:layout_constraintTop_toTopOf="@id/ivCounterSkinBox"
            tools:text="9" />

        <TextView
            android:id="@+id/tvCounter3"
            android:layout_width="34sp"
            android:layout_height="0dp"
            android:fontFamily="@font/font_digital_seven"
            android:gravity="center_vertical|end"
            android:lines="1"
            android:maxLength="1"
            android:paddingBottom="8dp"
            android:textAlignment="gravity"
            android:textColor="@android:color/black"
            android:textSize="70sp"
            app:layout_constraintBottom_toBottomOf="@id/ivCounterSkinBox"
            app:layout_constraintEnd_toStartOf="@id/tvCounter2"
            app:layout_constraintTop_toTopOf="@id/ivCounterSkinBox"
            tools:text="9" />

        <TextView
            android:id="@+id/tvCounter4"
            android:layout_width="33sp"
            android:layout_height="0dp"
            android:fontFamily="@font/font_digital_seven"
            android:gravity="center_vertical|end"
            android:lines="1"
            android:maxLength="1"
            android:paddingBottom="8dp"
            android:textAlignment="gravity"
            android:textColor="@android:color/black"
            android:textSize="70sp"
            app:layout_constraintBottom_toBottomOf="@id/ivCounterSkinBox"
            app:layout_constraintEnd_toStartOf="@id/tvCounter3"
            app:layout_constraintTop_toTopOf="@id/ivCounterSkinBox"
            tools:text="9" />

        <TextView
            android:id="@+id/tvCounter5"
            android:layout_width="33sp"
            android:layout_height="0dp"
            android:fontFamily="@font/font_digital_seven"
            android:gravity="center_vertical|end"
            android:lines="1"
            android:maxLength="1"
            android:paddingBottom="8dp"
            android:textAlignment="gravity"
            android:textColor="@android:color/black"
            android:textSize="70sp"
            app:layout_constraintBottom_toBottomOf="@id/ivCounterSkinBox"
            app:layout_constraintEnd_toStartOf="@id/tvCounter4"
            app:layout_constraintTop_toTopOf="@id/ivCounterSkinBox"
            tools:text="9" />

        <ImageView
            android:id="@+id/fabReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="40dp"
            app:layout_constraintBottom_toTopOf="@+id/fabCount"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/ic_reset_flowers" />

        <ImageView
            android:id="@+id/fabCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/ic_counter_flowers" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/adViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:minHeight="?android:actionBarSize"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_min="0dp"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>