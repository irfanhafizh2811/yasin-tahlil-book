<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_al_mulk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="36dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_surah_dark_theme">

                    <TextView
                        android:id="@+id/tv_arabic_surah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_lpmq_isep_misbah"
                        android:text="الْمُلْك"
                        android:textColor="@android:color/white"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_title_al_mulk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/font_izmir_heavy"
                android:text="@string/label_surah_al_mulk"
                android:textColor="@color/colorPrimaryPurple"
                android:textSize="24sp"
                app:layout_constraintStart_toEndOf="@+id/cv_al_mulk"
                app:layout_constraintTop_toTopOf="@id/cv_al_mulk" />

            <TextView
                android:id="@+id/tv_title_al_mulk_mean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/font_izmir_light"
                android:text="@string/label_surah_mean_al_mulk"
                android:textColor="@color/colorPrimaryPurple"
                android:textSize="24sp"
                app:layout_constraintStart_toEndOf="@+id/cv_al_mulk"
                app:layout_constraintTop_toTopOf="@id/tv_title_al_mulk" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_read"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/colorAccent"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="@id/tv_title_al_mulk_mean"
                app:layout_constraintStart_toStartOf="@id/tv_title_al_mulk_mean"
                app:layout_constraintTop_toBottomOf="@id/tv_title_al_mulk_mean">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_izmir_heavy"
                    android:gravity="center"
                    android:minWidth="120dp"
                    android:paddingTop="10dp"
                    android:text="@string/label_read"
                    android:textAlignment="gravity"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvLastRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surah_dark_theme"
                android:minHeight="160dp">

                <ImageView
                    android:id="@+id/ivSmallQuran"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_quran_last_read_mini" />

                <TextView
                    android:id="@+id/tvSmallQuran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/font_izmir_light"
                    android:text="Last Read"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/ivSmallQuran"
                    app:layout_constraintStart_toEndOf="@id/ivSmallQuran"
                    app:layout_constraintTop_toTopOf="@id/ivSmallQuran" />

                <TextView
                    android:id="@+id/tvLastReadSurah"
                    style="@style/TextView.Shadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/font_izmir_bold"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="@id/ivSmallQuran"
                    app:layout_constraintTop_toBottomOf="@id/ivSmallQuran"
                    tools:text="Surah Al Mulk" />

                <TextView
                    android:id="@+id/tvLastReadVerse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="@id/tvLastReadSurah"
                    app:layout_constraintTop_toBottomOf="@id/tvLastReadSurah"
                    tools:text="Verse 12" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvContinue"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/colorAccent"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvLastReadVerse">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_izmir_heavy"
                        android:gravity="center"
                        android:minWidth="100dp"
                        android:paddingVertical="10dp"
                        android:text="Continue"
                        android:textAlignment="gravity"
                        android:textAllCaps="true"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:layout_width="320dp"
                    android:layout_height="240dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="120dp"
                    android:paddingBottom="88dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="parent"
                    app:srcCompat="@drawable/ic_quran" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tv_title_surah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_izmir_heavy"
                android:paddingHorizontal="10dp"
                android:text="@string/list_of_the_surah"
                android:textColor="@color/colorPrimaryPurple"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/colorPrimaryPurple"
                app:layout_constraintEnd_toEndOf="@id/tv_title_surah"
                app:layout_constraintStart_toStartOf="@id/tv_title_surah"
                app:layout_constraintTop_toBottomOf="@id/tv_title_surah" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAddDhikr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvYourDhikr"
            tools:itemCount="5"
            tools:listitem="@layout/item_main_surah" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>