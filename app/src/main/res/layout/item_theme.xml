<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="64dp"
    android:minHeight="64dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvTheme"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="26dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/tvTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTheme"
                android:layout_width="48dp"
                android:layout_height="48dp"
                tools:ignore="ContentDescription"
                tools:srcCompat="@drawable/ic_picker_flower" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.01"
        android:textColor="#909090"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/cvTheme"
        app:layout_constraintStart_toStartOf="@id/cvTheme"
        app:layout_constraintTop_toBottomOf="@id/cvTheme"
        tools:text="Flower" />

    <View
        android:id="@+id/vw_theme_new"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="@id/cvTheme"
        app:layout_constraintTop_toTopOf="@id/cvTheme" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvNewTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#9D2121"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="@id/vw_theme_new"
        app:layout_constraintStart_toStartOf="@id/vw_theme_new"
        app:layout_constraintTop_toTopOf="@id/cvTheme"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="0.5dp"
            android:paddingBottom="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="@string/label_new"
                android:textAlignment="gravity"
                android:textColor="@android:color/white"
                android:textSize="@dimen/font_new_size" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>