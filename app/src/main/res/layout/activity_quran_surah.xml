<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.skydoves.expandablelayout.ExpandableLayout
        android:id="@+id/appbar_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:expandable_animation="accelerate"
        app:expandable_isExpanded="false"
        app:expandable_parentLayout="@layout/activity_surah_expand_parent"
        app:expandable_secondLayout="@layout/activity_surah_expand_second"
        app:expandable_showSpinner="false"
        app:layout_constraintBottom_toTopOf="@+id/rv_surah"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_surah"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appbar_tools"
        tools:itemCount="3"
        tools:listitem="@layout/item_quran_verse" />
</androidx.constraintlayout.widget.ConstraintLayout>